---
/**
 * Authors: Gabriel Muñoz, José González
 * 
 * Description: This is the authorizer view of the dashboard.
 **/

import TextHeader from "@components/Layout/TextHeader.astro";
import RequestSection from "@components/Cards/RequestSection.astro";
import { apiRequest } from "@utils/apiClient";
import { getCookie } from "@data/cookies";
import { getSocietyName } from "@data/societyHelper";

const requests = await (async () => {
  try {
    const userId = getCookie("id", Astro.cookies);
    return await apiRequest(`/authorizer/get-pending-requests/${userId}/0`, { cookies: Astro.cookies });
  } catch (error) {
    return [];
  }
})()
const { userName } = Astro.props;
const societyName = await getSocietyName(Astro);
---

<div>
  <main>
    <TextHeader
      title={`Bienvenido, ${userName}`}
      subtitle={societyName}
    />
      <RequestSection
        title="Solicitudes por autorizar"
        requests={requests}
        anchor="autorizaciones"
        urlBase="autorizar-solicitud"
        subtitle="Esta solicitud está esperando ser autorizada."
        emptyMessage="No hay solicitudes por autorizar"
      />
  </main>
</div>

