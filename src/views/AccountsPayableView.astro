---
/**
 * Accounts payable view of the dashboard
 */

import TextHeader from "@components/Layout/TextHeader.astro";
import RequestSection from "@components/Cards/RequestSection.astro";

import { getCookie } from "@data/cookies";
import { apiRequest } from '@utils/apiClient';
const userId = getCookie("id", Astro.cookies);

// Get requests in "Por cotizar" and "Por comprobar" states for the user's department
const requestsInCotizar = await (async () => {
  try {
    return await apiRequest(`/user/get-travel-requests/${userId}/4`, { cookies: Astro.cookies });
  } catch (error) {
    console.error("Error fetching cotizar requests:", error);
    return [];
  }
})()

// Get requests in "Por comprobar" state for the user's department
const requestsInComprobar = await (async () => {
  try {
    return await apiRequest(`/user/get-travel-requests/${userId}/7`, { cookies: Astro.cookies });
  } catch (error) {
    return [];
  }
})()

const { userName } = Astro.props;
---

<div>
  <main>
    <TextHeader
      title={`Bienvenido, ${userName}`}
      subtitle="Ditta Consulting"
    />

    <div class="grid grid-cols-1 gap-20">
      <RequestSection
        title="Solicitudes por cotizar"
        requests={requestsInCotizar}
        anchor="cotizaciones"
        urlBase="cotizar-solicitud"
        subtitle="Esta solicitud está esperando cotización."
        emptyMessage="No hay solicitudes por cotizar"
      />

      <RequestSection
        title="Solicitudes por comprobar"
        requests={requestsInComprobar}
        anchor="comprobaciones"
        urlBase="comprobar-gastos"
        subtitle="Esta solicitud está esperando comprobación."
        emptyMessage="No hay solicitudes por comprobar"
      />
    </div>
  </main>
</div>
