---
/**
 * Author: Kenia Esmeralda Ramos Javier.
 *
 * This component displays the detailed information of a travel
 * request in a structured and styled way, matching TravelRequestForm layout.
 *
 * Includes a button to navigate back to the requests history.
 */

import TextHeader from "@components/Layout/TextHeader.astro";
import Button from "@/components/Buttons/Button";
import LabeledValue from "@/components/Utils/LabeledValue";
import MaterialIcon from "@/components/Utils/MaterialIcon.astro";
import RouteDetailCard from "@/components/Cards/RouteDetailCard";
import Icon from "@/components/Utils/Icon";
import { getCookie } from "@data/cookies";
import TravelSearchCard from "@/components/Cards/TravelSearchCard";
import ConfirmationDocumentForm from "@/components/Forms/ConfirmationDocumentForm";
import type { UserRole } from "@/types/roles";
import RequestStepper from "@/components/UI/RequestStepper";

const { request, title, subtitle, showStepper = false, backHref = "/dashboard" } = Astro.props;
const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const token = getCookie("token", Astro.cookies) || "";

const requiresAgency = request.routes?.some(
  (r: any) => r.hotel_needed || r.plane_needed
) ?? false;
---

<main class="flex flex-col items-center">
  <TextHeader
    title={title}
    subtitle={subtitle}
    backHref={backHref}
  />

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 w-full">
    {showStepper && (
      <div class="lg:col-span-1 lg:sticky lg:top-6 p-6 h-fit order-first lg:order-last">
        <h3 class="text-lg font-semibold text-text-primary mb-6">Progreso</h3>
        <RequestStepper
          client:load
          currentStatus={request.request_status}
          requiresAgency={requiresAgency}
          authorizationLevel={request.authorization_level}
          authorizationLevelsTotal={request.authorization_levels_total}
        />
      </div>
    )}

    {/* Main Content - below timeline on mobile, left on desktop */}
    <div class={`space-y-6 order-last lg:order-first ${showStepper ? 'lg:col-span-3' : 'lg:col-span-4'}`}>
      {/* General Information Section */}
      <div class="card">
        <div class="card-title">
          <h2>Información General</h2>
        </div>
        <div class="space-y-4">
          {/* Status */}
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <LabeledValue
              label="Estado"
              value={request.request_status}
            />
            <LabeledValue
              label="Fecha de Creación"
              value={request.creation_date}
            />
          </div>

          {/* User Details */}
          <div class="mb-4">
            <h4 class="text-base font-semibold text-text-primary mb-3 flex items-center gap-2">
              <Icon name="person" />
              Datos del Usuario
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <LabeledValue
                label="Nombre"
                value={request.user.user_name}
              />
              <LabeledValue
                label="Correo"
                value={request.user.user_email}
              />
            </div>
          </div>

          {/* Fees and Dates */}
          <div class="mb-4">
            <h4 class="text-base font-semibold text-text-primary mb-3 flex items-center gap-2">
              <Icon name="payments" />
              Tarifas y Fechas
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <LabeledValue
                label="Cuota Solicitada"
                value={`$${request.requested_fee.toFixed(2)}`}
              />
              <LabeledValue
                label="Cuota Impuesta"
                value={typeof request.imposed_fee === 'number' && request.imposed_fee > 0
                  ? `$${request.imposed_fee.toFixed(2)}`
                  : 'Sin asignar'}
              />
            </div>
          </div>
        </div>
      </div>

      {/* Routes Section */}
      <div class="card">
        <div class="card-title">
          <h2>Rutas</h2>
        </div>
        <div class="space-y-4">
          {request.routes.map((route: any, index: number) => (
            <>
              <RouteDetailCard client:load route={route} index={index} />
              {role === "Agencia de viajes" && (
                <>
                  <div class="mt-4">
                    <TravelSearchCard
                      client:load
                      route={route}
                      routeIndex={index}
                      token={token}
                    />
                  </div>
                  <div class="mt-4">
                    <ConfirmationDocumentForm
                      client:load
                      route={route}
                      routeId={route.route_id}
                      token={token}
                    />
                  </div>
                </>
              )}
            </>
          ))}
        </div>
      </div>
      {/* Reservation Files Section */}
      { role !== "Agencia de viajes" &&
        request.routes.some(
          (route: any) => route.flight_pdf_file_id || route.hotel_pdf_file_id,
        ) && (
          <div class="card">
            <div class="card-title">
              <h2 class="text-xl font-bold text-text-primary flex items-center gap-2">
                <MaterialIcon icon="description" color="text-primary" style="text-lg" />
                Documentos de Reservación
              </h2>
            </div>
            <div class="space-y-4">
              {request.routes.map(
                (route: any, index: number) =>
                  (route.flight_pdf_file_id || route.hotel_pdf_file_id) && (
                    <div class="space-y-2">
                      <p class="text-sm font-semibold text-text-primary">
                        Ruta #{index + 1}
                      </p>
                      {route.flight_pdf_file_id && (
                        <div class="flex w-full bg-card-hover p-2 border border-border rounded-md gap-4 items-center justify-between">
                          <div class="flex flex-col items-start justify-center gap-1">
                            <p class="text-md font-semibold text-text-primary">
                              Vuelo PDF
                            </p>
                            <p class="text-xs text-text-primary">
                              {route.flight_pdf_file_name}
                            </p>
                          </div>
                          <a
                            href={`${import.meta.env.PUBLIC_API_BASE_URL}/files/receipt-file/${route.flight_pdf_file_id}`}
                          >
                            <Button
                              color="secondary"
                              variant="border"
                              size="small"
                            >
                              Descargar
                            </Button>
                          </a>
                        </div>
                      )}
                      {route.hotel_pdf_file_id && (
                        <div class="flex w-full bg-card-hover p-2 border border-border rounded-md gap-4 items-center justify-between">
                          <div class="flex flex-col items-start justify-center gap-1">
                            <p class="text-md font-semibold text-text-primary">
                              Hotel PDF
                            </p>
                            <p class="text-xs text-text-primary">
                              {route.hotel_pdf_file_name}
                            </p>
                          </div>
                          <a
                            href={`${import.meta.env.PUBLIC_API_BASE_URL}/files/receipt-file/${route.hotel_pdf_file_id}`}
                          >
                            <Button
                              color="secondary"
                              variant="border"
                              size="small"
                            >
                              Descargar
                            </Button>
                          </a>
                        </div>
                      )}
                    </div>
                  ),
              )}
            </div>
          </div>
        )
      }

      {/* Notes Section */}
      <div class="card mt-6">
        <div class="card-title">
          <h2>Observaciones / Comentarios</h2>
        </div>
        <p>
          {request.notes? request.notes : "No hay observaciones para esta solicitud."}
        </p>
      </div>
    </div>
  </div>
</main>
