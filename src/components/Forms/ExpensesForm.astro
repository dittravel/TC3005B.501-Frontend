---
/**
 * This component renders a form for submitting travel expenses related 
 * to a specific travel request.
 */

import ExpensesFormClient from "@components/Forms/ExpensesForm.tsx";
import { getCookie } from "@data/cookies";
import { apiRequest } from "@utils/apiClient";
import TextHeader from "@components/Layout/TextHeader.astro";
import Tag from "@/components/Utils/Tag";

const { id } = Astro.params;
const user_id = getCookie("id", Astro.cookies);

const travelData = await (async () => {
  try {
    return await apiRequest(`/applicant/get-user-request/${id}`, { cookies: Astro.cookies });
  } catch (error) {
    return {};
  }
})();
---
<div class="mb-6">
  <TextHeader
    title="Agregar comprobante de gastos"
    subtitle="Adjunta los comprobantes relacionados con el destino del viaje"
  />
  <section>
    <ExpensesFormClient
      client:only="react"
      requestId={travelData.request_id}
      routes={travelData.routes || []}
      token={getCookie("token", Astro.cookies) || ""}
      receiptToReplace={Astro.props.receiptToReplace}
    />
  </section>
</div>
