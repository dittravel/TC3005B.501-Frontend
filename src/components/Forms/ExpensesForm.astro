---
/**
 * This component renders a form for submitting travel expenses related 
 * to a specific travel request.
 */

import { getCookie } from "@data/cookies";
import { apiRequest } from "@utils/apiClient";
import TextHeader from "@components/Layout/TextHeader.astro";
import ExpensesFormClient from "@components/Forms/ExpensesForm";

const { id } = Astro.params;

// Fetch request data
const request = await (async () => {
  try {
    return await apiRequest(`/user/get-travel-request/${id}`, { cookies: Astro.cookies });
  } catch (error) {
    return {};
  }
})();

// Fetch society data to get the local currency
const society = await (async () => {
  try {
    return await apiRequest("/societies/current", { cookies: Astro.cookies });
  } catch (error) {
    return null;
  }
})();

// Fetch currencies data
const currencies = await (async () => {
  try {
    const response = await apiRequest("/exchange-rate/catalog", { cookies: Astro.cookies });
    return response.data || [];
  } catch (error) {
    return [];
  }
})();
---
<div class="mb-6">
  <TextHeader
    title="Agregar comprobante de gastos"
    subtitle="Adjunta los comprobantes relacionados con el destino del viaje"
  />
  <section>
    <ExpensesFormClient
      client:only="react"
      requestId={request.request_id}
      routes={request.routes || []}
      token={getCookie("token", Astro.cookies) || ""}
      mode="create"
      societyCurrency={society.currency}
      currencies={currencies}
      redirectTo={`/comprobar-solicitud/${request.request_id}`}
    />
  </section>
</div>
