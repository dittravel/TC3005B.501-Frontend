---
/**
 * Author: Julia Maria Stephanie Duenkelsbuehler Castillo
 * 
 * This component is a header for our system.
 * 
 * Example usage:
 * 	<PageHeader
 *    userName="John Doe"
 *		buttonLabel="Admin"
 *    showNotifications={true}
 *  />
 */

const { userName, buttonLabel, showNotifications = false } = Astro.props;
import MaterialIcon from "@components/Utils/MaterialIcon.astro";
import UserMenu from "@/components/Buttons/UserMenu";
import ThemeButton from "@components/Buttons/ThemeButton.astro";
import MenuButton from "@components/Buttons/MenuButton.astro";
import NotificationsButton from "@components/Buttons/NotificationsButton.astro";
---

<header class="h-15 flex justify-between items-center bg-header-bg px-4 py-3 border-b border-border">
  <!-- Left Section -->
  <div class="h-15 flex items-center px-5 gap-4">
    <MenuButton />
    <img
      src="/logo_texto_dittravel_blanco.png"
      class="w-auto h-full rounded drop-shadow-lg cursor-pointer hidden md:block"
      onclick="if(confirm('¿Volver al dashboard?')) window.location.href = '/dashboard'"
      title="Volver al dashboard"
      alt="Logo Dittravel"
    />
  </div>

  <!-- Right Section -->
  <div class="h-full flex items-center gap-4">

    <!-- Theme Toggle Button -->
    <ThemeButton />

    <!-- User Role -->
    <span
      class="text-brand-200 font-bold text-sm max-w-[80px] truncate sm:max-w-none sm:overflow-visible sm:whitespace-normal"
      title={buttonLabel}
    >
      {buttonLabel}
    </span>
    <!-- User Info -->
    <UserMenu client:load>
      <span class="text-black">{userName}</span>
      <MaterialIcon icon="account_circle" color="black" />
    </UserMenu>

    <!-- Notifications Button -->
    {showNotifications && <NotificationsButton />}
  </div>
</header>