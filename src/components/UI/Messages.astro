---
/**
 * This component fetches and displays system notifications (alerts) 
 * for the user based on their role and department.
 */

import { apiRequest } from "@/utils/apiClient";
import { getCookie } from "@data/cookies";
import MaterialIcon from "@components/Utils/MaterialIcon.astro";
import { formatDate } from '@utils/dateFormatter';
import { resolveDashboardProfile, shouldShowDashboardMessages } from '@/utils/userExperience';

function parseJwtPayload(token: string): Record<string, unknown> | null {
  try {
    const parts = token.split('.');
    if (parts.length < 2) return null;

    const base64 = parts[1].replaceAll('-', '+').replaceAll('_', '/');
    const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
    return JSON.parse(Buffer.from(padded, 'base64').toString('utf8'));
  } catch {
    return null;
  }
}

const userRole = String(getCookie("role", Astro.cookies) || '');
const token = String(getCookie("token", Astro.cookies) || '');
const tokenPayload = parseJwtPayload(token);
const permissionKeys = Array.isArray(tokenPayload?.permissions)
  ? tokenPayload.permissions.map((permission: unknown) => String(permission).trim()).filter(Boolean)
  : [];
const profile = resolveDashboardProfile(userRole, permissionKeys);
const alerts = await (async () => {
  if (!shouldShowDashboardMessages(profile)) {
    return [];
  }

  try {
    return await apiRequest(`/authorizer/get-alerts/${getCookie("id", Astro.cookies)}/10`, { cookies: Astro.cookies });
  } catch (error) {
    return [];
  }
})()
---

<div class="h-full w-full flex flex-col bg-card p-4 border-l border-border">
  <h2 class="text-xl font-bold text-text-primary mb-2 wrap-break-word">Notificaciones</h2>
  <ul class="space-y-4 pb-8 overflow-y-auto flex-1">
    {alerts.length === 0 && (
      <li>
        <div class="flex flex-col px-4 py-2 gap-2 border border-border rounded-xl shadow-md">
          <span class="text-lg text-text-primary font-semibold">No hay notificaciones disponibles</span>
          <span class="text-sm text-text-secondary">Las notificaciones del sistema aparecerán aquí cuando estén disponibles.</span>
        </div>
      </li>
    )}
    {alerts.map((alert:any) => (
      <li class="relative bg-card border border-border rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-2 flex flex-col gap-2 bg-secondary/10">
          <div class="flex items-center gap-2">
            <MaterialIcon icon="calendar_today" color="" style="text-xs text-text-primary" />
            <p class="text-xs text-text-primary">
              {formatDate(alert.alert_date)} - {alert.alert_time}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <MaterialIcon icon="account_circle" color="" style="text-xs text-text-primary" />
            <p class="text-xs text-text-primary">Usuario: <span class="font-semibold">{alert.user_name}</span></p>
          </div>
          <div class="flex items-center gap-2">
            <MaterialIcon icon="receipt" color="" style="text-xs text-text-primary" />
            <p class="text-xs text-text-primary">ID Solicitud: <span class="font-semibold">{alert.request_id}</span></p>
          </div>
        </div>
        <hr class="border-t border-border" />
        <div class="px-4 py-2">
          <p class="text-sm text-text-primary">{alert.message_text}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
