---
/**
 * Page for editing an existing receipt/comprobante.
 */

export const prerender = false;

import MainLayout from "@layouts/MainLayout.astro";
import ExpensesFormClient from "@components/Forms/ExpensesForm.tsx";

import { getCookie } from "@data/cookies";
import type { UserRole } from "@type/roles";
import { roleLabels } from "@config/role-labels";
import TextHeader from "@components/Layout/TextHeader.astro";
import Tag from "@/components/Utils/Tag";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const userName = getCookie("username", Astro.cookies) || "";
const buttonLabel = roleLabels[role];

const { receiptId, id } = Astro.params;
const requestId = id;

// Fetch receipt data for editing
let receiptData = null;
let travelData = null;
let society = null;
let currencies = [];

try {
  receiptData = await apiRequest(`/applicant/get-receipt/${receiptId}`, { cookies: Astro.cookies });
  travelData = await apiRequest(`/user/get-travel-request/${requestId}`, { cookies: Astro.cookies });
  society = await apiRequest("/societies/current", { cookies: Astro.cookies });
  const currenciesRes = await apiRequest("/exchange-rate/catalog", { cookies: Astro.cookies });
  currencies = currenciesRes.data || [];
} catch (error) {
  console.error("Error fetching receipt or travel data:", error);
}

if (!receiptData || !travelData) {
  return Astro.redirect("/dashboard");
}
---

<MainLayout title="Editar Comprobante" data={{userName, buttonLabel, role}}>
  <div class="mb-6">
    <TextHeader
      title="Editar comprobante de gastos"
      subtitle="Actualiza los detalles del comprobante"
      backHref={`/comprobar-solicitud/${requestId}`}
    />
    <section>
      <ExpensesFormClient
        client:only="react"
        requestId={travelData.request_id}
        routes={travelData.routes || []}
        token={getCookie("token", Astro.cookies) || ""}
        mode="edit"
        data={receiptData}
        societyCurrency={society?.local_currency}
        currencies={currencies}
        redirectTo={`/comprobar-solicitud/${requestId}`}
      />
    </section>
  </div>
</MainLayout>
