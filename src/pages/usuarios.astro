---
/**
 * Users Management Page
 * 
 * This page allows administrators to view, edit, and delete users in the system. 
 * It displays a list of all users with their details and provides actions for managing each user. 
 */
import MainLayout from "@layouts/MainLayout.astro";
import TextHeader from "@components/Layout/TextHeader.astro";
import TableFallback from "@components/Table/TableFallback.astro";
import UltimateWrapper from "@/components/Modals/UltimateWrapper";
import type { UserRole } from "@type/roles";
import { getCookie } from "@data/cookies";
import { apiRequest } from "@/utils/apiClient";
import Button from "@/components/Buttons/Button";
import Tag from "@/components/Utils/Tag";
import { getStatusTagType } from "@/utils/statusMapper";
import { getSocietyName } from "@data/societyHelper";
import { roleLabels } from "@config/role-labels";
import ArbolJerarquia from "@/components/Users/ApproverHierarchyTree";

interface User {
  user_id: number;
  user_name: string;
  email: string;
  role_name: string;
  department_name: string;
  cost_center_name?: string;
  active?: boolean;
}

// Fetch users
let errorMessage = null;
const users = await (async () => {
  try {
    return await apiRequest(`/admin/get-user-list`, {
      cookies: Astro.cookies
    });
  } catch (error) {
    errorMessage = "Error al cargar los usuarios. Por favor, inténtalo de nuevo más tarde.";
    return [];
  }
})();

// Sort users by ID ascending
if (users && users.length > 0) {
  users.sort((a: User, b: User) => a.user_id - b.user_id);
}

const hierarchyUsers = users.map((user: User) => ({
  userId: user.user_id,
  userName: user.user_name,
  roleName: user.role_name,
  departmentName: user.department_name,
}));

// Get society name for header subtitle
const societyName = await getSocietyName(Astro);

// Get user role and name for layout
const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const userName = getCookie("username", Astro.cookies) || "";
const buttonLabel = roleLabels[role];

function parseJwtPayload(jwtToken: string): Record<string, unknown> | null {
  try {
    const parts = jwtToken.split('.');
    if (parts.length < 2) return null;

    const base64 = parts[1].replaceAll('-', '+').replaceAll('_', '/');
    const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
    return JSON.parse(Buffer.from(padded, 'base64').toString('utf8'));
  } catch {
    return null;
  }
}

const token = getCookie("token", Astro.cookies) || "";
const tokenPayload = parseJwtPayload(token);
const permissionKeys = Array.isArray(tokenPayload?.permissions)
  ? tokenPayload.permissions.map((permission: unknown) => String(permission).trim()).filter(Boolean)
  : [];
const permissionSet = new Set(permissionKeys);
const canViewUsers = permissionSet.has('users:view');
const canCreateUsers = permissionSet.has('users:create');
const canEditUsers = permissionSet.has('users:edit');
const canDeleteUsers = permissionSet.has('users:delete');

if (!canViewUsers) {
  return Astro.redirect('/404');
}
---

<MainLayout title="Usuarios" data={{userName, buttonLabel, role}}>
  <div>
    {errorMessage ? (
      <div class="bg-warning-50 border border-warning-500 text-warning-500 px-4 py-3 rounded mb-4">
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 3a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 000 2v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
          <strong>Error:</strong> {errorMessage}
        </div>
      </div>
    ) : null}

    {users && users.length === 0 && !errorMessage ? (
      <TableFallback />
    ) : users.length > 0 ? (
      <>
        <TextHeader
          title="Gestión de Usuarios"
          subtitle={societyName}
        />

        <section class="w-full">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
             <h2 class="text-xl font-bold text-text-primary">{`Usuarios del Sistema (${users.length})`}</h2>
             <div class="flex items-center gap-3 self-end sm:self-auto">
              <div class="inline-flex border border-border rounded-lg overflow-hidden" role="group" aria-label="Modo de vista de usuarios">
                <button
                  id="users-view-table-btn"
                  type="button"
                  class="users-view-toggle-btn users-view-toggle-btn-active px-3 py-2 text-sm font-medium flex items-center gap-2"
                  aria-label="Ver tabla de usuarios"
                  aria-pressed="true"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v3H3V4zm0 5h14v3H3V9zm0 5h14v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2z" />
                  </svg>
                  Tabla
                </button>
                <button
                  id="users-view-tree-btn"
                  type="button"
                  class="users-view-toggle-btn px-3 py-2 text-sm font-medium flex items-center gap-2"
                  aria-label="Ver jerarquía de usuarios"
                  aria-pressed="false"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M4 3a1 1 0 00-1 1v3a1 1 0 001 1h2v2a1 1 0 001 1h2v2H8a1 1 0 00-1 1v3a1 1 0 001 1h3a1 1 0 001-1v-3a1 1 0 00-1-1h-1v-2h2a1 1 0 001-1V8h2a1 1 0 001-1V4a1 1 0 00-1-1h-3a1 1 0 00-1 1v2h-2V4a1 1 0 00-1-1H4zm0 1h3v3H4V4zm8 0h3v3h-3V4zM8 14h3v3H8v-3z" />
                  </svg>
                  Jerarquía
                </button>
              </div>
              {canCreateUsers && (
                <Button href="/crear-usuario" color="secondary">Crear Usuario</Button>
              )}
             </div>
          </div>

          <div id="users-table-view" class="overflow-x-auto border border-border rounded-lg">
            <table class="min-w-full" style="background-color: var(--color-table-bg);">
              <thead class="bg-secondary">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-brand-50">ID</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-brand-50">Usuario</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-brand-50">Correo</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-brand-50">Rol</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-brand-50">Departamento</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-brand-50">Centro de Costos</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-brand-50">Acciones</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-brand-50"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {users.map((user: User, index: number) => (
                  <tr class={index % 2 === 0 ? 'bg-card' : 'bg-card-hover'}>
                    <td class="px-4 py-4 text-sm text-text-primary">{user.user_id}</td>
                    <td class="px-4 py-4">
                      <div class="text-sm font-medium text-text-primary">{user.user_name}</div>
                    </td>
                    <td class="px-4 py-4 text-sm text-text-primary">{user.email}</td>
                    <td class="px-4 py-4">
                      <span class={"inline-flex px-2 py-1 text-xs font-semibold rounded-full"}>
                        <Tag type={getStatusTagType(user.role_name)} text={user.role_name} />
                      </span>
                    </td>
                    <td class="px-4 py-4 text-sm text-text-primary">{user.department_name || 'Admin'}</td>
                    <td class="px-4 py-4 text-sm text-text-primary">{user.cost_center_name || 'N/A'}</td>
                    <td class="px-4 py-4 text-center">
                      {canEditUsers ? (
                        <Button href={`/editar-usuario/${user.user_id}`} color="primary">Editar</Button>
                      ) : (
                        <span class="text-xs text-text-secondary">Sin permiso</span>
                      )}
                    </td>
                    <td class="px-4 py-4">
                      {canDeleteUsers ? (
                        <UltimateWrapper
                          client:only="react"
                          id={user.user_id}
                          endpoint="/admin/delete-user"
                          title="Eliminar usuario"
                          message={`¿Estás seguro de que deseas eliminar al usuario ${user.user_name}? Esta acción no se puede deshacer.`}
                          modal_type="warning"
                          color="warning"
                          label="Eliminar"
                          token={token}
                        />
                      ) : (
                        <span class="text-xs text-text-secondary">Sin permiso</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div id="users-tree-view" class="hidden mt-2">
            <ArbolJerarquia
              client:load
              users={hierarchyUsers}
              initialUserId={hierarchyUsers[0].userId}
              allowUserSelection={true}
              token={token}
            />
          </div>

          <div class="mt-4 text-sm text-text-secondary">
            <span>Total de usuarios: {users.length}</span>
          </div>
        </section>

        <script>
          const tableButton = document.getElementById('users-view-table-btn');
          const treeButton = document.getElementById('users-view-tree-btn');
          const tableView = document.getElementById('users-table-view');
          const treeView = document.getElementById('users-tree-view');

          const setActiveView = (view: 'table' | 'tree') => {
            if (!tableView || !treeView || !tableButton || !treeButton) return;

            const showTable = view === 'table';
            tableView.classList.toggle('hidden', !showTable);
            treeView.classList.toggle('hidden', showTable);

            tableButton.classList.toggle('users-view-toggle-btn-active', showTable);
            treeButton.classList.toggle('users-view-toggle-btn-active', !showTable);
            tableButton.setAttribute('aria-pressed', String(showTable));
            treeButton.setAttribute('aria-pressed', String(!showTable));
          };

          tableButton?.addEventListener('click', () => setActiveView('table'));
          treeButton?.addEventListener('click', () => setActiveView('tree'));
        </script>

        <style>
          .users-view-toggle-btn {
            background-color: var(--color-card, #fff);
            color: var(--color-text-secondary, #6b7280);
          }

          .users-view-toggle-btn + .users-view-toggle-btn {
            border-left: 1px solid var(--color-border, #d1d5db);
          }

          .users-view-toggle-btn-active {
            background-color: var(--color-secondary, #1f2937);
            color: var(--color-brand-50, #f9fafb);
          }
        </style>
      </>
    ) : null}
  </div>
</MainLayout>
