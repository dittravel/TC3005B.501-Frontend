---
/**
 * Generic page for creating or editing a society group
 * - /grupos-sociedades/nuevo - Create new society group
 * - /grupos-sociedades/123 - Edit society group with ID 123
 */

import TextHeader from "@components/Layout/TextHeader.astro";
import MainLayout from "@layouts/MainLayout.astro";
import SocietyGroupForm from "@components/Forms/SocietyGroupForm";
import SocietyGroupEditPanel from "@components/Forms/SocietyGroupEditPanel";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";
const token = getCookie("token", Astro.cookies) || "";
const { id } = Astro.params;

// Determine if we're creating or editing
const isCreating = id === "nuevo";
const isEditing = id && id !== "nuevo";

let data = null;
if (isEditing) {
  try {
    data = await apiRequest(`/society-groups/${id}`, { cookies: Astro.cookies });
  } catch (error) {
    data = null;
    throw error;
  }
}

let groups = [];
if (isEditing) {
  try {
    const response = await apiRequest('/society-groups', { cookies: Astro.cookies });
    groups = Array.isArray(response) ? response : [];
  } catch {
    groups = [];
  }
}

const currencies = await (async () => {
  if (!isCreating) {
    return [];
  }

  try {
    const response = await apiRequest('/exchange-rate/catalog', { cookies: Astro.cookies });
    return Array.isArray(response) ? response : (response?.data || []);
  } catch {
    return [];
  }
})();
---

<MainLayout title={isCreating ? "Crear Grupo de Sociedad" : "Editar Grupo de Sociedad"} data={{userName, buttonLabel, role}}>
  <div>
    <TextHeader
      title={isCreating ? "Crear nuevo grupo de sociedad" : "Editar Grupo de Sociedad"}
      subtitle={isCreating ? "Complete el formulario con los datos del nuevo grupo de sociedad" : "Modifica los campos necesarios para actualizar la información del grupo de sociedad"}
      backHref="/grupos-sociedades"
    />
    {isCreating ? (
      <SocietyGroupForm
        client:load
        mode="create"
        token={token}
        redirectTo="/grupos-sociedades"
        currencies={currencies}
      />
    ) : (
      <SocietyGroupEditPanel
        client:load
        token={token}
        groupId={Number(id)}
        groupData={data}
        groups={groups}
        redirectTo="/grupos-sociedades"
      />
    )}
  </div>
</MainLayout>
