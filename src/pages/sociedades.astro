---
/**
 * Society Groups and Society Page
 * 
 * This page displays the society groups and societies in the system.
 */

import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import SocietyGroupsTable from "@components/Table/SocietyGroupsTable";
import SocietiesTable from "@components/Table/SocietiesTable";

import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";
const token = getCookie("token", Astro.cookies) || "";
const societyGroupId = getCookie("society_group_id", Astro.cookies) || "";

function parseJwtPayload(jwtToken: string): Record<string, unknown> | null {
  try {
    const parts = jwtToken.split('.');
    if (parts.length < 2) return null;
    const base64 = parts[1].replaceAll('-', '+').replaceAll('_', '/');
    const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
    return JSON.parse(Buffer.from(padded, 'base64').toString('utf8'));
  } catch {
    return null;
  }
}

const tokenPayload = parseJwtPayload(token);
const permissionKeys = Array.isArray(tokenPayload?.permissions)
  ? tokenPayload.permissions.map((permission: unknown) => String(permission).trim()).filter(Boolean)
  : [];

const canViewSocietyGroups = permissionKeys.includes('society_groups:view');
const canCreateSocietyGroup = permissionKeys.includes('society_groups:create');
const canEditSocietyGroup = permissionKeys.includes('society_groups:edit');
const canDeleteSocietyGroup = permissionKeys.includes('society_groups:delete');
const canViewSocieties = permissionKeys.includes('societies:view');
const canCreateSociety = permissionKeys.includes('societies:create');
const canEditSociety = permissionKeys.includes('societies:edit');
const canDeleteSociety = permissionKeys.includes('societies:delete');

// Get society groups
let isDefaultGroup = false;
const societyGroups = await (async () => {
  if (!canViewSocietyGroups) {
    return [];
  }

  try {
    const groups = await apiRequest(`/society-groups`, {
      cookies: Astro.cookies
    });
    // Check if user is in the default group
    const defaultGroup = groups.find((g: any) => g.is_default);
    if (defaultGroup && societyGroupId && parseInt(societyGroupId) === defaultGroup.id) {
      isDefaultGroup = true;
    }
    return groups;
  } catch (error) {
    console.error("Error al cargar los grupos de sociedades:", error);
    return [];
  }
})();

// Get societies
const societies = await (async () => {
  if (!canViewSocieties) {
    return [];
  }

  try {
    return await apiRequest(`/societies`, {
      cookies: Astro.cookies
    });
  } catch (error) {
    console.error("Error al cargar las sociedades:", error);
    return [];
  }
})();
---

<MainLayout title="Sociedades" data={{userName, buttonLabel, role}}>
  <TextHeader
    title="Sociedades"
    subtitle="Configura las sociedades del sistema"
  />
  <main>
    <div class="flex flex-col gap-8">
      {canViewSocietyGroups && isDefaultGroup && (
        <SocietyGroupsTable
          client:load
          data={societyGroups}
          token={token}
          role={role}
          canCreate={canCreateSocietyGroup}
          canEdit={canEditSocietyGroup}
          canDelete={canDeleteSocietyGroup}
        />
      )}
      {canViewSocieties ? (
        <SocietiesTable
          client:load
          data={societies}
          token={token}
          role={role}
          canCreate={canCreateSociety}
          canEdit={canEditSociety}
          canDelete={canDeleteSociety}
        />
      ) : null}
    </div>
  </main>
</MainLayout>

