---
/**
 * crear-rol.astro
 *
 * Admin-only page for creating a new system role.
 */

import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import CreateRoleForm from "@/components/Forms/CreateRoleForm";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";

if (role !== "Administrador") {
  return Astro.redirect("/404");
}
---

<MainLayout title="Crear Rol" data={{ userName, buttonLabel, role }}>
  <TextHeader
    title="Crear Rol"
    subtitle="Define el nombre y permisos del nuevo rol"
  />
  <main>
    <CreateRoleForm 
      client:only="react" 
      token={getCookie("token", Astro.cookies) || ""}
      mode='create'/>
  </main>
</MainLayout>