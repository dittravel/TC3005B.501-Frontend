---
/**
 * This is the edit user page where an existing user's details can be modified.
 */

import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import AdminUserForm from "@/components/Forms/AdminUserForm";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";
const { id } = Astro.params;

// Fetch user data
let user_data = null;
try {
  user_data = await apiRequest(`/user/get-user-data/${id}`, { cookies: Astro.cookies });
} catch (error) {
  user_data = null;
  throw new Error(`No user found with ID ${id}`);
}

// Get departments
const departments = await (async () => {
  try {
    return await apiRequest(`/admin/get-departments`, {
      headers: { Authorization: `Bearer ${getCookie("token", Astro.cookies) || ""}` },
    });
  } catch (error) {
    console.error("Error al cargar las reglas de autorización:", error);
    return [];
  }
})();

// Get roles
const roles = await (async () => {
  try {
    return await apiRequest(`/admin/get-roles`, {
      headers: { Authorization: `Bearer ${getCookie("token", Astro.cookies) || ""}` },
    });
  } catch (error) {
    console.error("Error al cargar las reglas de autorización:", error);
    return [];
  }
})();
---

<MainLayout title="Editar usuario" data={{userName, buttonLabel, role}}>
  <div>
    <TextHeader
      title="Editar Usuario"
      subtitle="Modifica los campos necesarios para actualizar la información del usuario"
    />
    <AdminUserForm
      client:load
      mode="edit"
      user_data={user_data}
      redirectTo="/dashboard"
      token={getCookie("token", Astro.cookies) || ""}
      departments={departments}
      roles={roles}
    />
  </div>
</MainLayout>
