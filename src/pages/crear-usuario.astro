---
/**
 * Creation page for a new, single user.
 */

import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import AdminUserForm from "@/components/Forms/AdminUserForm";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";
const societyGroupId = getCookie("society_group_id", Astro.cookies) || "";

// Get departments
const departments = await (async () => {
  try {
    const allDepartments = await apiRequest(`/admin/get-departments`, {
      headers: { Authorization: `Bearer ${getCookie("token", Astro.cookies) || ""}` },
    });
    // Filter departments to only show those in the admin's society group
    if (societyGroupId) {
      return allDepartments.filter((dept: any) => dept.society_group_id === parseInt(societyGroupId as string));
    }
    return allDepartments;
  } catch (error) {
    console.error("Error al cargar las reglas de autorización:", error);
    return [];
  }
})();

// Get roles
const roles = await (async () => {
  try {
    return await apiRequest(`/admin/get-roles`, {
      headers: { Authorization: `Bearer ${getCookie("token", Astro.cookies) || ""}` },
    });
  } catch (error) {
    console.error("Error al cargar las reglas de autorización:", error);
    return [];
  }
})();

const defaultRole = await (async () => {
  try {
    return await apiRequest('/admin/get-default-role', {
      headers: { Authorization: `Bearer ${getCookie("token", Astro.cookies) || ""}` },
      cookies: Astro.cookies,
    });
  } catch (error) {
    console.error("Error loading default role:", error);
    return null;
  }
})();

// Get societies
const societies = await (async () => {
  try {
    return await apiRequest(`/societies`, {
      cookies: Astro.cookies
    });
  } catch (error) {
    console.error("Error loading societies:", error);
    return [];
  }
})();

---

<MainLayout title="Crear Usuario" data={{userName, buttonLabel, role}}>
  <div>
    <TextHeader
      title="Crear nuevo usuario"
      subtitle="Complete el formulario con los datos del nuevo usuario"
    />
    <AdminUserForm
      mode="create"
      client:load
      redirectTo="/dashboard"
      departments={departments}
      roles={roles}
      societies={societies}
      token={getCookie("token", Astro.cookies) || ""}
      defaultRoleId={defaultRole?.role_id || null}
    />
  </div>
</MainLayout>

