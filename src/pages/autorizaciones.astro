---
import MainLayout from "@layouts/MainLayout.astro";
import TextHeader from "@components/Layout/TextHeader.astro";
import AuthRequestsList from "@/components/Lists/AuthRequestsList";
import TableFallback from "@/components/Table/TableFallback.astro";

import type { UserRole } from "@type/roles";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const userName = getCookie("username", Astro.cookies) || "";
const buttonLabel = roleLabels[role];

// Fetch pending requests assigned to this user
const requests = await (async () => {
  try {
    const userId = getCookie("id", Astro.cookies);
    return await apiRequest(`/authorizer/get-pending-requests/${userId}/0`, { cookies: Astro.cookies });
  } catch (error) {
    return [];
  }
})();
---

<MainLayout title="Autorizaciones Pendientes" data={{ userName, buttonLabel, role }}>
  <div>
    {requests && requests.length === 0 ? (
      <TableFallback />
    ) : (
      <>
        <TextHeader
          title={"Autorizaciones de " + userName}
          subtitle="Aquí puedes ver las solicitudes pendientes de autorizar"
        />
        <AuthRequestsList
          client:only="react"
          data={requests}
          role={role}
          type="autorizar-solicitud"
        />
      </>
    )}
  </div>
</MainLayout>