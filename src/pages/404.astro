---
/**
 * 404 page for unauthorized access or non-existent routes.
 * It provides a user-friendly message and a button to navigate back to the appropriate page based 
 * on authentication status.
 */

import Layout from "@layouts/Layout.astro";
import Button from "@components/Buttons/Button";
const token = Astro.cookies.get("token")?.value;
const isAuthenticated = !!token;
---

<Layout title="Página no encontrada">
  <main
    class="min-h-screen bg-background text-white px-6 flex flex-col"
  >
    <div class="grow flex flex-col gap-4 justify-center items-center text-center w-full">
      <h1 class="text-5xl font-extrabold flex gap-2 justify-center items-baseline">
        <span class="text-warning-400">404:</span>
        <span class="text-text-primary">No Encontrado</span>
      </h1>
      <p class="text-text-primary text-lg leading-relaxed">
        ¡Ups! Parece que estás perdido o no tienes permiso para acceder a esta página.
      </p>
      <Button
        href={isAuthenticated ? "/dashboard" : "/"}
        variant="link"
        color="secondary"
        size="big"
      >
        {isAuthenticated ? "Volver al Dashboard" : "Volver a Inicio"}
      </Button>
    </div>
  </main>
</Layout>
