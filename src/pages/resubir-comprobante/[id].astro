---
/**
* This script defines the page for re-uploading a receipt.
*/

export const prerender = false;

import MainLayout from "@layouts/MainLayout.astro";
import ExpensesFormClient from "@components/Forms/ExpensesForm.tsx";
import TextHeader from "@components/Layout/TextHeader.astro";

import { getCookie } from "@data/cookies";
import type { UserRole } from "@type/roles";
import { roleLabels } from "@config/role-labels";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const userName = getCookie("username", Astro.cookies) || "";
const buttonLabel = roleLabels[role];

const url = new URL(Astro.request.url);
const receiptToReplace = url.searchParams.get("replace");

const { id } = Astro.params;
const requestId = id;

// Fetch receipt data and travel request data
let receiptData = null;
let travelData = null;
let society = null;
let currencies = [];

try {
  if (receiptToReplace) {
    receiptData = await apiRequest(`/applicant/get-receipt/${receiptToReplace}`, { cookies: Astro.cookies });
  }
  travelData = await apiRequest(`/user/get-travel-request/${requestId}`, { cookies: Astro.cookies });
  society = await apiRequest("/societies/current", { cookies: Astro.cookies });
  const currenciesRes = await apiRequest("/exchange-rate/catalog", { cookies: Astro.cookies });
  currencies = currenciesRes.data || [];
} catch (error) {
  console.error("Error fetching data:", error);
}

if (!travelData) {
  return Astro.redirect("/dashboard");
}
---

<MainLayout title="Resubir Comprobante" data={{userName, buttonLabel, role}}>
  <div class="mb-6">
    <TextHeader
      title="Resubir comprobante de gastos"
      subtitle="Carga nuevamente los archivos del comprobante rechazado"
    />
    <section>
      <ExpensesFormClient
        client:only="react"
        requestId={travelData.request_id}
        routes={travelData.routes || []}
        token={getCookie("token", Astro.cookies) || ""}
        mode={receiptData ? "resubmit" : "create"}
        data={receiptData}
        societyCurrency={society?.currency}
        currencies={currencies}
        redirectTo={`/comprobar-solicitud/${requestId}`}
      />
    </section>
  </div>
</MainLayout>