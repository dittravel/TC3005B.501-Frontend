---
/**
 * Page for viewing pending quotations for applicants
 */

import MainLayout from "@layouts/MainLayout.astro";
import TextHeader from "@components/Layout/TextHeader.astro";
import Requests from "@/components/Requests/Requests";
import TableFallback from "@/components/Table/TableFallback.astro";

import type { UserRole } from "@type/roles";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import { apiRequest } from '@utils/apiClient';

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const userName = getCookie("username", Astro.cookies) || "";
const buttonLabel = roleLabels[role];
const token = getCookie("token", Astro.cookies) || "";

const requests = await (async () => {
  try {
    const userId = getCookie("id", Astro.cookies);
    return await apiRequest(`/requests/${userId}?status=Cotización del Viaje&assignedOnly=true`, { cookies: Astro.cookies });
  } catch (error) {
    return [];
  }
})()
---

<MainLayout title="Cotizaciones Pendientes" data={{userName, buttonLabel, role}}>
  <TextHeader
    title="Solicitudes por Cotizar"
    subtitle="Aquí puedes ver las solicitudes pendientes de cotizar"
  />
  {requests && requests.length === 0 ? (
    <TableFallback />
  ) : (
    <Requests
      client:load
      data={requests}
      token={token}
      hideFilters={true}
      actionRoute="/cotizar-solicitud"
    />
  )}
</MainLayout>
