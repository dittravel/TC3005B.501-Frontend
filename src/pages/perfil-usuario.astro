---
/**
* User porfile info page
*/

import MainLayout from "@layouts/MainLayout.astro";
import Typography from "@components/Utils/Typography.astro";
import TextHeader from "@components/Layout/TextHeader.astro";
import UserProfile from "@components/Forms/UserProfile";

import type { UserRole } from "@type/roles";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import { apiRequest } from "@/utils/apiClient";
import { resolveDashboardProfile } from "@/utils/userExperience";

function parseJwtPayload(jwtToken: string): Record<string, unknown> | null {
  try {
    const parts = jwtToken.split('.');
    if (parts.length < 2) return null;

    const base64 = parts[1].replaceAll('-', '+').replaceAll('_', '/');
    const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
    return JSON.parse(Buffer.from(padded, 'base64').toString('utf8'));
  } catch {
    return null;
  }
}

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const userName = getCookie("username", Astro.cookies) || "";
const userId = getCookie("id", Astro.cookies);
const token = getCookie("token", Astro.cookies) || "";
const buttonLabel = roleLabels[role];
const tokenPayload = parseJwtPayload(String(token || ''));
const permissionKeys = Array.isArray(tokenPayload?.permissions)
  ? tokenPayload.permissions.map((permission: unknown) => String(permission).trim()).filter(Boolean)
  : [];
const profile = resolveDashboardProfile(role, permissionKeys);
const canManageAbsence = profile === 'travel-agency' || profile === 'accounts-payable' || profile === 'authorizer';

const userData = await apiRequest(`/user/get-user-data/${userId}`, { cookies: Astro.cookies });

let departmentUsers = [];
if (canManageAbsence) {
  departmentUsers = await apiRequest(`/user/get-substitute-users/${userId}`, { cookies: Astro.cookies });
}
---

<MainLayout title="Perfil de Usuario" data={{userName, buttonLabel, role}}>
  <TextHeader
    title="Perfil de usuario"
    subtitle="Aquí puedes ver tu información personal."
    backHref="/dashboard"
  />
  <main>
    <UserProfile
      client:load
      userData={userData} 
      departmentUsers={departmentUsers}
      token={token}
      canManageAbsence={canManageAbsence}
      role={role}
      permissionKeys={permissionKeys}
    />
  </main>
</MainLayout>
