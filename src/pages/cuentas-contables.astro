---
/**
 * Accounting Accounts Page
 * 
 * This page displays the accounting accounts for the selected society 
 * and allows users with the appropriate permissions to manage them.
 */

import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import AccountsTable from "@components/Table/AccountsTable";

import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";
const token = getCookie("token", Astro.cookies) || "";

function parseJwtPayload(jwtToken: string): Record<string, unknown> | null {
  try {
    const parts = jwtToken.split('.');
    if (parts.length < 2) return null;
    const base64 = parts[1].replaceAll('-', '+').replaceAll('_', '/');
    const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
    return JSON.parse(Buffer.from(padded, 'base64').toString('utf8'));
  } catch {
    return null;
  }
}

const tokenPayload = parseJwtPayload(token);
const permissionKeys = Array.isArray(tokenPayload?.permissions)
  ? tokenPayload.permissions.map((permission: unknown) => String(permission).trim()).filter(Boolean)
  : [];

const canViewAccounts = permissionKeys.includes('accounts:view');
const canCreateAccount = permissionKeys.includes('accounts:create');
const canEditAccount = permissionKeys.includes('accounts:edit');
const canDeleteAccount = permissionKeys.includes('accounts:delete');

// Get accounting accounts
const accounts = await (async () => {
  if (!canViewAccounts) {
    return Astro.redirect('/404');
  }

  try {
    const result = await apiRequest(`/accounts`, {
      cookies: Astro.cookies
    });
    return result || [];
  } catch (error) {
    console.error("Error al cargar las cuentas contables:", error);
    return [];
  }
})();
---

<MainLayout title="Cuentas Contables" data={{userName, buttonLabel, role}}>
  <TextHeader
    title="Cuentas Contables"
    subtitle="Configura las cuentas contables del sistema"
  />
  <main>
    {canViewAccounts ? (
      <AccountsTable
        client:load
        data={accounts}
        token={token}
        canCreate={canCreateAccount}
        canEdit={canEditAccount}
        canDelete={canDeleteAccount}
      />
    ) : (
      null
    )}
  </main>
</MainLayout>

