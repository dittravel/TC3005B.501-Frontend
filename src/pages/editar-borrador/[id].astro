---
/**
 * Page to edit a travel request using mock data from get-user-request.json
 */

export const prerender = false;
import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import TravelRequestForm from "@/components/Forms/TravelRequestForm";

import type { UserRole } from "@type/roles";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";

import { apiRequest } from "@/utils/apiClient";

const { id } = Astro.params;
let request = null;
let currencies = [];
let countries = [];
let cities = [];

try {
  request = await apiRequest(`/user/get-travel-request/${id}`, { cookies: Astro.cookies });
} catch (error) {
  request = null;
  throw new Error(`No request found with ID ${id}`);
}

// Fetch currencies from the backend
try {
  const response = await apiRequest('/exchange-rate/catalog', { cookies: Astro.cookies });
  currencies = response.data || [];
} catch (error) {
  console.error('Error fetching currencies:', error);
}

// Fetch countries and cities for the form dropdowns
try {
  countries = await apiRequest('/countries', { cookies: Astro.cookies });
  cities    = await apiRequest('/cities',    { cookies: Astro.cookies });
} catch (error) {
  console.error('Error fetching countries/cities:', error);
}
---

<MainLayout title="Completar Draft" data={{ userName, buttonLabel, role }}>
  <div>
    <TextHeader
      title="Editar borrador de solicitud"
      subtitle="Por favor termine de llenar el siguiente borrador por completo"
      backHref="/solicitudes"
    />
    <main>
      <TravelRequestForm
        client:only="react"
        data={request}
        mode='draft'
        request_id={id}
        user_id={getCookie("id", Astro.cookies) || ""}
        role={role}
        token={getCookie("token", Astro.cookies) || ""}
        currencies={currencies}
        countries={countries}
        cities={cities}
      />
    </main>
  </div>
</MainLayout>
