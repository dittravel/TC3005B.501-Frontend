---
/**
 * Exporting page for accountability data
 */

import TextHeader from '@components/Layout/TextHeader.astro';
import MainLayout from "@layouts/MainLayout.astro";
import AccountingExportForm from "@/components/Forms/ExportAccountabilityForm";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { only } from 'node:test';

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role] || "";
const token = getCookie("token", Astro.cookies) || "";
---

<MainLayout title="Exportar datos contables" data={{ buttonLabel, role}}>
  <div>
    <TextHeader
      title="Exportar datos contables"
      subtitle="Complete el formulario de acuerdo a la información que desee exportar"
    />
    <AccountingExportForm 
      client:load
      token={token}
    />
  </div>
</MainLayout>

