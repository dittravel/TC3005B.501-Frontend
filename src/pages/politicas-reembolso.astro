---
/**
 * Refund Policies Page
 */

import TextHeader from "@components/Layout/TextHeader.astro";
import MainLayout from "@layouts/MainLayout.astro";
import DefaultRefundPolicy from "@components/Forms/DefaultRefundPolicy";
import RefundPoliciesList from "@components/Lists/RefundPoliciesList";
import { getCookie } from "@data/cookies";
import { roleLabels } from "@config/role-labels";
import type { UserRole } from "@type/roles";
import { apiRequest } from "@/utils/apiClient";

const role: UserRole = getCookie("role", Astro.cookies) as UserRole;
const buttonLabel = roleLabels[role];
const userName = getCookie("username", Astro.cookies) || "";

// Get refund policies list
const policies = await (async () => {
  try {
    return await apiRequest(`/refund-policy`, {
      cookies: Astro.cookies
    });
  } catch (error) {
    console.error("Error al cargar las políticas de reembolso:", error);
    return [];
  }
})();

// Get society info (for local currency)
const society = await (async () => {
  try {
    const data = await apiRequest(`/societies/current`, {
      cookies: Astro.cookies
    });
    return data || null;
  } catch (error) {
    console.error("Error al cargar la sociedad del usuario:", error);
    return null;
  }
})();

// Get token
const token = getCookie("token", Astro.cookies) || "";
---

<MainLayout title="Políticas de Reembolso" data={{userName, buttonLabel, role}}>
  <TextHeader
    title="Políticas de Reembolso"
    subtitle="Configura y gestiona las políticas de reembolso del sistema"
  />
  <main>
    <DefaultRefundPolicy
      client:load
      defaultPolicy={policies.find((p: any) => p.is_default)}
      currency={society?.local_currency || "MXN"}
      token={token}
    />
    <RefundPoliciesList
      client:load
      data={policies}
      currency={society?.local_currency || "MXN"}
      token={token}
    />
  </main>
</MainLayout>
